# All integrations work in fully-mocked "demo mode" with no keys set at all.
# Set any of these to switch that provider from mock data to a real API call.

# --- Image generation (the AI model/influencer shots) ---
# Presence of this key switches lib/providers/imageProvider.ts from the local
# SVG mock renderer to a real call. Works with an OpenAI (gpt-image-1) key today;
# see the TODO in that file for Gemini/Stability request shapes.
IMAGE_PROVIDER_API_KEY=

# --- Live product search (local / regional / online retailers) ---
# Presence of this key switches lib/providers/productProvider.ts from the
# local seed catalog (data/catalog.json) to a real SerpApi Google Shopping call.
SERPAPI_KEY=

# --- Checkout / agentic commerce ---
# No mature standard exists yet to integrate here for real. Left as a seam in
# lib/providers/checkoutProvider.ts for when one (e.g. Stripe's Agentic
# Commerce Protocol) becomes available. No key needed today.
CHECKOUT_PROVIDER_API_KEY=

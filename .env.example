# All integrations work in fully-mocked "demo mode" with no keys set at all.
# Set any of these to switch that provider from mock data to a real API call.

# --- Image generation (the AI model/influencer shots) ---
# Presence of this key switches lib/providers/imageProvider.ts from the local
# SVG mock renderer to a real call. Works with an OpenAI (gpt-image-1) key today;
# see the TODO in that file for Gemini/Stability request shapes.
IMAGE_PROVIDER_API_KEY=

# --- Live online product search (Google Shopping via SerpApi) ---
# Get a key at https://serpapi.com/ (free tier available). Presence of this
# key makes lib/providers/googleShoppingProvider.ts return real, live Google
# Shopping results instead of nothing. The local seed catalog still fills in
# alongside it, so results never go empty.
SERPAPI_KEY=

# --- Live local-store inventory + local pickup (Shopify Storefront API) ---
# There is no public "search all nearby stores" API, but if you (or a local
# boutique you know) run a Shopify store, its public, read-only Storefront
# API can show real in-stock products with a local-pickup framing. Generate
# a Storefront API access token in Shopify Admin -> Settings -> Apps and
# sales channels -> Develop apps -> (create app) -> Storefront API scope.
# This is a JSON array (single line) of every store to pull from:
#   SHOPIFY_STORES=[{"name":"Studio Verve","domain":"studio-verve.myshopify.com","token":"<storefront-access-token>","region":"Bengaluru"}]
SHOPIFY_STORES=

# --- Checkout / agentic commerce ---
# No mature standard exists yet to integrate here for real. Left as a seam in
# lib/providers/checkoutProvider.ts for when one (e.g. Stripe's Agentic
# Commerce Protocol) becomes available. No key needed today.
CHECKOUT_PROVIDER_API_KEY=

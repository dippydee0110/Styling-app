# API
PORT=4000
API_PUBLIC_BASE_URL=http://localhost:4000

# Required: used to encrypt each user's MCP URL at rest.
APP_ENCRYPTION_KEY=replace-with-strong-random-secret

# Robinhood MCP base URL (can be overridden per user from OAuth response)
MCP_TRADING_URL=https://agent.robinhood.com/mcp/trading

# Robinhood OAuth configuration for per-user API credential capture
ROBINHOOD_OAUTH_AUTHORIZE_URL=
ROBINHOOD_OAUTH_TOKEN_URL=
ROBINHOOD_OAUTH_CLIENT_ID=
ROBINHOOD_OAUTH_CLIENT_SECRET=
ROBINHOOD_OAUTH_SCOPE=mcp.read
ROBINHOOD_MCP_URL=

# Optional dev OAuth mock settings
ENABLE_DEV_MOCK_ROBINHOOD_OAUTH=false
DEV_ROBINHOOD_MCP_URL=https://mock-robinhood-mcp.local
DEV_ROBINHOOD_MCP_API_KEY=

# Optional: route MCP calls through OpenAI SDK Responses MCP tools
OPENAI_USE_MCP_SDK=false
OPENAI_API_KEY=
OPENAI_MCP_MODEL=gpt-5-mini
MCP_TOOL_SCAN_PREMIUM_CANDIDATES=scan-premium-candidates
MCP_TOOL_CONTEXT_SUMMARY=context-summary
MCP_TOOL_EXECUTE_TRADE=execute-trade

# Phase 2 auth/session + persistence settings
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trading_copilot
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
VERIFICATION_CODE_TTL_MINUTES=10
AUTO_VERIFY_REGISTRATION=true
# Optional for managed Postgres
# PG_SSLMODE=require

# Security hardening controls
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_MAX_ATTEMPTS_PER_WINDOW=8
AUTH_VERIFY_MAX_ATTEMPTS_PER_WINDOW=15
AUTH_LOGIN_MAX_ATTEMPTS_PER_WINDOW=10
AUTH_REFRESH_MAX_ATTEMPTS_PER_WINDOW=40
AUTH_BROKER_CONFIG_MAX_ATTEMPTS_PER_WINDOW=12
EXECUTE_TRADE_MAX_ATTEMPTS_PER_WINDOW=30
# In non-production mode, localhost requests bypass route rate limits.
